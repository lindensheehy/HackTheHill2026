# Copy to .env. With nothing set the app runs in FOSS mode: SQLite, offline assistant, browser speech, no login.

# --- Storage: Tiger Cloud (or any PostgreSQL). Empty = SQLite at data/app.db
DATABASE_URL=
# e.g. postgresql://tsdbadmin:PASSWORD@abc123.tsdb.cloud.timescale.com:34567/tsdb?sslmode=require

# --- Gemini assistant + investigation briefs (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_CALLS_PER_DAY=300
GEMINI_MAX_OUTPUT_TOKENS=700

# --- ElevenLabs spoken updates (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_MAX_CHARS_PER_DAY=15000
ELEVENLABS_MAX_CHARS_PER_REQUEST=600

# --- Login (optional; any OIDC provider, set up for Auth0)
AUTH_ENABLED=false
AUTH_DOMAIN=
AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_ROLES_CLAIM=https://northwind-triage/roles
# email-or-sub:role pairs; roles: viewer, agent, lead, analyst
AUTH_ROLE_MAP=
AUTH_DEFAULT_ROLE=viewer

# --- Hosting
DETECT_INTERVAL_MINUTES=0
DOMAIN=
REBUILD_ON_START=true
